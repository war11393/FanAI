# ============================================================
# 后端（NestJS）环境变量模板
# 复制为 server/.env 后填写；.env 不会被提交
# ============================================================

# ---- 数据库（Supabase / 任意 Postgres 托管实例）----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
*** 可选：服务端操作用的高权限 key
SUPABASE_SERVICE_ROLE_KEY=

# ---- 对象存储（可选：Supabase Storage 的 bucket 名，用于拍照识别食材）----
# 不配置时后端自动回退 base64 data URL 直传视觉模型
SUPABASE_STORAGE_BUCKET=

# ---- AI 大模型 ----
# http（默认）：任何 OpenAI 兼容接口；wechat：转发到微信云函数 HTTP 触发器
AI_PROVIDER=http

# Provider = http 时生效
# 例：DeepSeek https://api.deepseek.com/v1 (model: deepseek-chat，不支持视觉)
# 例：通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1 (model: qwen-vl-plus)
# 例：Kimi https://api.moonshot.cn/v1
AI_HTTP_BASE_URL=
AI_HTTP_API_KEY=
AI_HTTP_MODEL=
# 视觉识别使用的模型（需支持 image_url 输入）
AI_HTTP_VISION_MODEL=

# Provider = wechat 时生效（云函数骨架见 cloudfunctions/ai-service）
AI_WECHAT_URL=
AI_WECHAT_TOKEN=

# ---- 服务端口 ----
SERVER_PORT=3000
