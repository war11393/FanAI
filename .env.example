# ============================================================
# 前端（Taro）环境变量模板
# 复制为 .env.local 后按需填写；.env.local 不会被提交
# ============================================================

# 生产环境 API 域名（小程序/H5 请求前缀，如 https://your-domain.com）
# 留空时 H5 走本地 Vite proxy（/api -> http://localhost:SERVER_PORT）
PROJECT_DOMAIN=

# H5 开发服务器端口（默认 5000）
PORT=5000

# NestJS 后端端口（默认 3000，需与 dev 代理一致）
SERVER_PORT=3000

# ---- 微信小程序 CI 上传（可选，配置后 pnpm preview:weapp 可直接推送体验版）----
TARO_APP_WEAPP_APPID=

# ---- 抖音小程序（可选）----
TARO_APP_TT_APPID=
TARO_APP_TT_EMAIL=
TARO_APP_TT_PASSWORD=
